# ============================================================
# mochi-oa-server-go 环境配置（复制为 .env 后按需修改）
#   （.env 含密钥/密码，已加入 .gitignore，切勿提交）
# ============================================================

# ---- 服务端基础 ----
HOST=0.0.0.0
PORT=80
SERVER_PORT=80
# 传输方式：websocket,polling；Cloudflare 等只放行 HTTP/HTTPS 时用 polling
TRANSPORTS=websocket,polling
TRUST_PROXY=false
# 跨域来源：* 或逗号分隔列表（如 https://oa.example.com,https://admin.example.com）
CORS_ORIGIN=*
# Socket.IO 路径，默认 /socket.io
SOCKET_PATH=/socket.io
# 存储实现：只有 MySQL 一种（旧的内存模式已移除，此项保留仅为兼容旧 .env）
STORAGE=mysql

# ---- MySQL ----
# 全新服务器无需事先建库建表：下面两个开关打开后，服务端自己按 GORM 模型创建
# 数据库（CREATE DATABASE IF NOT EXISTS，库名取 MYSQL_DATABASE）和全部表（AutoMigrate）。
# 只要该 MySQL 账号有 CREATE 权限即可；已有库表时重复启动是幂等的，不会改数据。
# Docker 部署时 MYSQL_HOST 用服务名 mysql（compose 里已覆盖，容器内不要写 127.0.0.1）。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=__MYSQL_PASSWORD_PLACEHOLDER__
MYSQL_DATABASE=mochioa
# 库不存在时自动创建（默认 true）
AUTO_CREATE_DATABASE=true
# 启动时按模型自动建表/补列（默认 true）
AUTO_MIGRATE=true

# ---- 认证 ----
JWT_SECRET=__JWT_SECRET_PLACEHOLDER__
JWT_EXPIRES_IN=30d

# ---- 初始管理员（首次启动播种到数据库的账号，可选）----
ADMIN_USER=
ADMIN_PASSWORD=

# ---- 服务器管理员（SERVER_ADMIN）----
# 逗号分隔的「用户名」列表。拥有服务器所有者权限（配置主邮件等），
# 基于用户、与公司/群角色权限无关。留空则回退到 ADMIN_USER（播种管理员）。
SERVER_ADMIN_USERS=

# ---- 主邮件（.env / Docker 配置，第一优先级）----
# 配置了 MAIL_HOST 即启用环境级主邮件（注册/登录验证码等系统邮件默认用它）。
# 未配置时，由客户端登录后（SERVER_ADMIN）在设置里写入数据库。
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=__MAIL_PASSWORD_PLACEHOLDER__
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_ENABLED=true

# ---- 本地文件存储 ----
FILE_DIR=./data
# 文件 URL 相对路径开关：true=对外返回 /files/...（默认，便于迁移）；false=用下面的 FILE_BASE_URL 拼绝对 URL 返回。数据库始终存相对路径
USE_RELATIVE_FILE_URL=true
# 绝对 URL 拼接源（origin，不带 /files），如 http://192.168.2.57；USE_RELATIVE_FILE_URL=false 时生效
FILE_BASE_URL=
FILE_MAX_BYTES=20971520

# ---- HTTPS（SSL_KEY 与 SSL_CERT 同时配置才启用；文件路径）----
SSL_KEY=
SSL_CERT=

# ---- WebRTC ICE ----
ICE_SERVERS="{\"iceServers\":[{\"urls\":\"stun:stun.l.google.com:19302\"}]}}"
ICE_USE_CLOUDFLARE=false
CLOUDFLARE_TURN_TOKEN=__CLOUDFLARE_TURN_TOKEN_PLACEHOLDER__
CLOUDFLARE_TURN_KEY_ID=
ICE_SERVERS_TOKEN_SECOND=86400

# ---- 爱发电（afdian）开放平台：AFDIAN_USER_ID 存在即启用；token 为敏感值只放 .env，不提交仓库 ----
AFDIAN_USER_ID=
AFDIAN_TOKEN=__AFDIAN_TOKEN_PLACEHOLDER__
AFDIAN_WEBHOOK_PUBLIC_KEY=

# ---- 日报/周报未交提醒 ----
# 触发时刻（HH:MM，服务器当地时间）：当前时间落在 [时刻, 时刻+10分钟) 窗口内即推送一次，
# 无状态窗口法天然防重复；定时器每 5 分钟 tick。日报每天触发；周报仅周五触发。
REPORT_REMIND_DAILY=18:00
REPORT_REMIND_WEEKLY=18:00
